{
  "name": "dmz-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test --test-concurrency=4 tests/runtime/*.test.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:tracker": "node tests/browser/quick-tracker.mjs",
    "check": "node scripts/check-python.mjs && npm test && npm run build",
    "format": "prettier --write \"src/**/*.mjs\" \"src/**/*.css\" \"scripts/*.mjs\" \"tests/**/*.mjs\" package.json",
    "format:check": "prettier --check \"src/**/*.mjs\" \"src/**/*.css\" \"scripts/*.mjs\" \"tests/**/*.mjs\" package.json",
    "test:engines": "node tests/browser/engines.mjs",
    "package": "npm run build && python scripts/package-release.py",
    "author": "node scripts/author.mjs",
    "author:recover": "node scripts/author.mjs --recover",
    "catalog:migrate": "node scripts/migrate-catalog.mjs",
    "test:studio": "node tests/browser/studio.mjs",
    "map:install": "npm --prefix tools/hajin-map ci",
    "map:dev": "npm --prefix tools/hajin-map run dev",
    "map:build": "npm --prefix tools/hajin-map run build",
    "map:test": "npm --prefix tools/hajin-map test",
    "map:test:capacity": "npm --prefix tools/hajin-map run test:capacity",
    "map:test:browser": "npm --prefix tools/hajin-map run test:browser",
    "weapons:check": "node scripts/weapon-database.mjs check",
    "weapons:apply": "node scripts/weapon-database.mjs apply",
    "weapons:validate": "node scripts/weapon-database.mjs validate",
    "test:weapons": "node scripts/weapon-database.mjs test",
    "weapons:manage": "node scripts/weapon-manager.mjs",
    "keys:images": "node scripts/collect-key-images.mjs",
    "weapons:art": "node scripts/collect-weapon-art.mjs",
    "weapons:source-check": "node scripts/codmunity.mjs check",
    "weapons:source-status": "node scripts/codmunity.mjs status",
    "test:keys": "node tests/browser/keys-run.mjs",
    "test:home": "node tests/browser/home-run.mjs",
    "test:home:a11y": "node tests/browser/home-accessibility.mjs",
    "sitemap:audit": "node scripts/site-topology-audit.mjs",
    "test:sitemap": "node tests/browser/site-topology-run.mjs",
    "test:ui:modern": "node scripts/test-modern-ui.mjs",
    "test:ui:map": "node scripts/test-modern-ui.mjs --map-only",
    "items:icons": "node scripts/collect-item-icons.mjs"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "acorn": "8.19.0",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "tesseract.js": "7.0.0"
  }
}
