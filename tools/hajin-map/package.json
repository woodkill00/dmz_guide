{
  "name": "dmz-local-map-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node scripts/run-tests.mjs",
    "test:browser": "node --experimental-strip-types scripts/test-workspace.cjs",
    "test:capacity": "node --experimental-strip-types tests/workspace-capacity.mjs",
    "test:inputs": "node --experimental-strip-types --test tests/inputs.test.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
