      ],
      "status": "verified",
      "relatedIds": [
        "mw4:imjin-farmland"
      ]
    },
    {
      "id": "guide:weapon-reference",
      "title": "Read weapon evidence carefully",
      "category": "weapons",
      "body": "The official weapon overview covers weapons available in Multiplayer and DMZ, but its unlock criteria describe Create-a-Class. This catalog does not treat those player levels as DMZ unlocks or assume Multiplayer figures are live DMZ measurements. Select a weapon to inspect the evidence scope and any unknown stats.",
      "spoiler": false,
      "sourceIds": [
        "source:weapons"
      ],
      "status": "verified",
      "relatedIds": [
        "mw4:m4",
        "mw4:han-86",
